rules_version = '2';

// DEEPostrophy - Firestore Security Rules (simplified, validator-safe)
// Put this whole text in Firebase Console > Firestore Database > <your DB> > Rules, then click Publish.
// Owner email must be EXACTLY this and the email must be verified:
function isOwner() {
  return request.auth != null
    && request.auth.token.email == 'arafathhossainrifath230119@gmail.com'
    && request.auth.token.email_verified == true;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /stores/{storeId} {
      allow read: if isOwner() || resource.data.published == true;
      allow write: if isOwner();
    }

    match /items/{itemId} {
      allow read: if isOwner() || resource.data.published == true;
      allow write: if isOwner();
    }

    match /faq/{faqId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Contact form: anyone may create a message with exactly these four fields.
    match /messages/{msgId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'email', 'body', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100
        && request.resource.data.email.contains('@')
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && request.resource.data.ts is timestamp;
      allow read, update, delete: if isOwner();
    }

    // Each signed-in visitor only touches their own users/{uid} doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Stats: anyone (including guests) can read and can create/update counters,
    // but only the four numeric fields, and numbers can never go negative.
    match /stats/{itemId} {
      allow read: if true;

      allow create: if
        request.resource.data.id == itemId
        && request.resource.data.keys().hasOnly(['id', 'downloads', 'saves', 'reactions'])
        && request.resource.data.downloads is int && request.resource.data.downloads >= 0
        && request.resource.data.saves is int && request.resource.data.saves >= 0
        && request.resource.data.reactions is map;

      allow update: if
        request.resource.data.id == itemId
        && request.resource.data.keys().hasOnly(['id', 'downloads', 'saves', 'reactions'])
        && request.resource.data.downloads is int && request.resource.data.downloads >= 0
        && request.resource.data.saves is int && request.resource.data.saves >= 0
        && request.resource.data.reactions is map;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
